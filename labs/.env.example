# Kopie als labs/.env anlegen und Werte anpassen. Die Notebooks lesen die Datei per python-dotenv.

# OpenAI-kompatibler LLM-Endpunkt. Default: LM Studio auf dem eigenen Rechner (Server-Tab, Port 1234).
LLM_BASE_URL=http://localhost:1234/v1
# Ollama-Alternative: LLM_BASE_URL=http://localhost:11434/v1
# Cloud-Alternative (Kundenschlüssel, Kosten beachten): LLM_BASE_URL=https://api.openai.com/v1

# API-Schlüssel. LM Studio prüft ihn nicht, braucht aber einen Wert.
LLM_API_KEY=lm-studio
# Ollama-Alternative: LLM_API_KEY=ollama
# Cloud-Alternative: LLM_API_KEY=sk-...

# Modellname, wie ihn der Endpunkt unter /v1/models meldet.
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Ollama-Alternative: LLM_MODEL=qwen3:8b (Modell vorher mit "ollama pull" laden)
# Cloud-Alternative: LLM_MODEL=gpt-4.1-mini

# Nur für Lab 4 (Review-Kommentar auf GitHub). Fine-grained Token mit minimalem Scope (Pull Requests: read/write).
# Leer lassen, wenn Lab 4 offline gegen das lokale Git-Repo laufen soll.
GITHUB_TOKEN=
# Übungsrepository in der Form owner/repo.
GITHUB_REPO=grigory-consulting/crewai-review-demo
