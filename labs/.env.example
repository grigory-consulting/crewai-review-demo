# LLM-Zugang für alle Labs. Kursstandard: OpenAI-API (Cloud).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4.1
# Lokale Alternative (Demo im Kurs): LM Studio, Server-Tab, Port 1234, Modell mit Tool-Calling laden
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lm-studio
#   LLM_MODEL=qwen/qwen3.6-35b-a3b
# Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen3:8b (vorher "ollama pull")
# Anderer OpenAI-kompatibler Anbieter (z. B. DeepSeek): LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-chat

# GitHub, nur für Lab 4 Schritt 7 (Review auf einen echten Pull Request posten). Leer lassen für den Offline-Betrieb.
GITHUB_TOKEN=
GITHUB_REPO=grigory-consulting/crewai-review-demo
